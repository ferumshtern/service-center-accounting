        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Client {\n        +int Id\n        +string FullName\n        +string Phone\n    }\n\n    class Device {\n        +int Id\n        +string Brand\n        +string Model\n        +string SerialNumber\n    }\n\n    class ServiceEngineer {\n        +int Id\n        +string FullName\n        +string Specialization\n    }\n\n    class RepairOrder {\n        +int Id\n        +string OrderNumber\n        +DateTime CreatedAt\n        +string IssueDescription\n        +string DiagnosticNotes\n        +decimal TotalCost\n        +OrderStatus Status\n        +AssignEngineer(engineer)\n        +AddRepairItem(name, qty, price)\n        +ChangeStatus(newStatus)\n        +CalculateTotalCost()\n    }\n\n    class RepairItem {\n        +int Id\n        +string Name\n        +int Quantity\n        +decimal UnitPrice\n        +decimal Subtotal\n    }\n\n    class StatusHistory {\n        +int Id\n        +OrderStatus Status\n        +DateTime ChangedAt\n    }\n\n    class OrderStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        Accepted_Прийнято\n        InProgress_В_роботі\n        Ready_Готово\n        Issued_Видано\n    }\n\n    Client \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Device : власник\n    Device \&quot;1\&quot; --&gt; \&quot;0..*\&quot; RepairOrder : передається в ремонт\n    ServiceEngineer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; RepairOrder : виконує\n    RepairOrder \&quot;1\&quot; *-- \&quot;0..*\&quot; RepairItem : містить роботи/деталі\n    RepairOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; StatusHistory : фіксує історію\n    RepairOrder --&gt; OrderStatus : поточний статус&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZI-Q8WGhTQFV_epO1rKX-1">
